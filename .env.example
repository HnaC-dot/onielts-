# =============================================================================
# Ôn IELTS — Environment Variables (.env.example)
# Copy this file to .env.local and fill in real credentials before production.
# NEVER expose server-only keys with NEXT_PUBLIC_ prefix.
# =============================================================================

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Postgres, Auth, Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only! NEVER send to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini AI (Server-only, wrapped in src/lib/ai.ts) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Payments: PayOS VietQR (Server-only, primary adapter) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Local development only (ignored in production)
PAYOS_SANDBOX=false

# --- Optional: Distributed Rate Limiting (Upstash Redis, server-only) ---
# When unset locally, falls back safely to bounded in-memory sliding window.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional: Bot Protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: Local/CI PostgreSQL URL for RLS integration tests ---
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
